# This repository is shared between macOS and Windows through Dropbox.
# Only explicitly listed text formats are normalized, using LF on every platform.
* -text

# Source, configuration, documentation, and tabular data
*.R             text eol=lf
*.r             text eol=lf
*.py            text eol=lf
*.Rmd           text eol=lf
*.rmd           text eol=lf
*.qmd           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.csv           text eol=lf
*.tsv           text eol=lf
*.gmt           text eol=lf
*.json          text eol=lf
*.ipynb         text eol=lf
*.Rproj         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.svg           text eol=lf
*.history       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
LICENSE         text eol=lf

# Historical terminal logs include bare carriage-return control characters.
# Preserve their existing byte representation rather than normalizing them.
refactoring_docs/test_output.txt          binary
refactoring_docs/workflow2_final_test.txt binary
refactoring_docs/workflow2_test_final.txt binary
refactoring_docs/workflow2_test_fixed.txt binary

# Opaque scientific data, office documents, figures, and Cytoscape sessions
*.RData         binary
*.Rdata         binary
*.rda           binary
*.rds           binary
*.h5            binary
*.hdf5          binary
*.xls           binary
*.xlsx          binary
*.pdf           binary
*.cys           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.tif           binary
*.tiff          binary
*.zip           binary
*.gz            binary
*.tar           binary

# Frozen COSMOS sources and results are referenced by byte-level checksums.
# Preserve their original line endings as well as their binary payloads.
results/causal_modelling/** -text !eol
support/cosmos_mouse/raw/** -text !eol

# These inputs, release artifacts and archived files already have SHA256
# provenance. Preserve exact bytes when adding them from macOS or Windows;
# source files still receive ordinary text diffs where Git detects text.
data/RNA/zonation/current/** -text !eol
data/RNA/pseudobulk_csv/** -text !eol
results/zonation_marker_update_20261116/** -text !eol
miscellaneous/** -text !eol

# New frozen inputs, engine copies and provenance must retain their recorded
# byte-level identities when staged and checked out on another platform.
data/metabolomics/cyp2c38ko/** -text !eol
data/metabolomics/fcg/** -text !eol
data/metabolomics/wd/** -text !eol
data/metabolomics/wdsd/** -text !eol
data/wp*_input_migration_manifest.csv -text !eol
docs/provenance/** -text !eol
docs/analysis_catalog.csv -text !eol
scripts/core/engines/** -text !eol
scripts/moon/archive/** -text !eol
results/validation/cyp2c38_in_vivo/** -text !eol
support/cosmos_mouse/comparison/** -text !eol
support/cosmos_mouse/moon_currency_*.csv -text !eol
